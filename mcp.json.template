# MCP client configuration template
# Copy this to your MCP client config directory and fill in your paths.
# For Claude Desktop: %APPDATA%\Claude\claude_desktop_config.json
# For VS Code Copilot: .vscode/mcp.json in your workspace

{
  "mcpServers": {
    "excel-excelmcp": {
      "command": "C:\\path\\to\\mcp-office\\.venv\\Scripts\\python.exe",
      "args": ["-m", "excelmcp.server"],
      "env": {
        "PYTHONPATH": "C:\\path\\to\\mcp-office\\excelmcp\\src",
        "EXCEL_ALLOWLIST_ROOTS": "C:\\path\\to\\your\\files",
        "EXCEL_ENABLE_WRITE": "true"
      }
    }
  }
}
